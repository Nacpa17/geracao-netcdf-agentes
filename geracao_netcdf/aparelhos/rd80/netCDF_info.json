    "variable_specific_attrs": {
        "qc_number_detected_particles": {
            "description": "This variable contains bit packed integer values, where each bit represents a QC test on the data. Non-zero bits indicate the QC condition given in the description for those bits; a value of 0 (no bits set) indicates the data has not failed any QC tests.",
            "bit_1_description": "No drops detected.",
            "bit_1_assessment": "Indeterminate",
            "bit_2_description": "Positive number of detected drops is below filter threshold (filter_ni).",
            "bit_2_assessment": "Indeterminate",
            "bit_3_description": "At least one class count is missing, non-finite or negative; total count is undefined.",
            "bit_3_assessment": "Bad",
            "bit_4_description": "Integration interval is missing, non-finite or not positive.",
            "bit_4_assessment": "Bad",
            "flag_masks": [
                1,
                2,
                4,
                8
            ],
            "flag_meanings": "no_drops low_positive_count invalid_class_counts invalid_interval",
            "comment": "A dry valid record sets bit 1 as information, not a failed measurement. Time steps without observation have undefined counts and interval (bits 3 and 4); see qc_time."
        },
        "qc_calibration": {
            "flag_masks": [
                1,
                2,
                4
            ],
            "flag_meanings": "on_or_after_calibration_1 on_or_after_calibration_2 on_or_after_calibration_3",
            "bit_1_description": "Data on or after first calibration date (see calib_date).",
            "bit_2_description": "Data on or after second calibration date.",
            "bit_3_description": "Data on or after third calibration date.",
            "comment": "State indicator, not a quality test. Zero means data before all calibration dates or a time step without observation."
        },
        "qc_sample_interval": {
            "description": "This variable contains bit packed integer values, where each bit represents a QC test on the data. Non-zero bits indicate the QC condition given in the description for those bits; a value of 0 (no bits set) indicates the data has not failed any QC tests.",
            "bit_1_description": "Assigned observation has absent, nonfinite or nonpositive integration interval.",
            "bit_1_assessment": "Bad",
            "bit_2_description": "Positive interval is less than nominal 60 s.",
            "bit_2_assessment": "Indeterminate",
            "bit_3_description": "Interval is greater than nominal 60 s.",
            "bit_3_assessment": "Indeterminate",
            "bit_4_description": "Not used",
            "bit_4_assessment": "Bad",
            "bit_5_description": "Not used",
            "bit_5_assessment": "Bad",
            "bit_6_description": "No source observation or selected long integration covers this nominal bin.",
            "bit_6_assessment": "Indeterminate",
            "flag_masks": [
                1,
                2,
                4,
                8,
                16,
                32
            ],
            "flag_meanings": "invalid_interval below_nominal above_nominal not_used_4 not_used_5 no_observation",
            "comment": "No tolerance: any positive interval below or above the nominal step is flagged.",
            "bit_4_comment": "Kept so that bit numbering matches RD80-Processing 3.1, which aggregates records; this generator never does.",
            "bit_5_comment": "Kept so that bit numbering matches RD80-Processing 3.1, which aggregates records; this generator never does."
        },
        "qc_time": {
            "description": "This variable contains bit packed integer values, where each bit represents a QC test on the data. Non-zero bits indicate the QC condition given in the description for those bits; a value of 0 (no bits set) indicates the data has not failed any QC tests."
        }
